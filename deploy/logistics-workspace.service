[Unit]
Description=Logistics Workspace API
After=network.target

[Service]
User=logistics
Group=logistics
WorkingDirectory=/opt/logistics-workspace/logistics-workspace
EnvironmentFile=/etc/logistics-workspace.env
ExecStart=/opt/logistics-workspace/backend-venv/bin/uvicorn backend.app:from_env --factory --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/logistics-workspace/data

[Install]
WantedBy=multi-user.target
